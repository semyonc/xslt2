# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
.codex/
.claude/

# Local Cargo configuration, e.g. a `[patch.crates-io]` override that builds
# against a local xsd-schema checkout. Never committed.
.cargo/
